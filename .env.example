# Backend
APP_NAME=Graphify AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./backend/graphify.db
UPLOAD_DIR=./backend/uploads
EXPORT_DIR=./backend/exports
MAX_UPLOAD_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:3000
AI_SCHEMA_MODE=heuristic
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=604800
REQUEST_LOGGING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/api/v1/health,/system/status,/api/v1/system/status,/docs,/redoc,/openapi.json

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
